# Bu sozlamalar BACKEND/.env ga qo'shiladi.
# Worker'ni endi backend o'zi ishga tushiradi — alohida token/jarayon kerak emas.

# --- Backend nimalarni avtomatik ko'tarishi ---
AUTOSTART_GO2RTC=true
AUTOSTART_RECOGNITION=true

# go2rtc bajariladigan fayl (default: ./go2rtc/go2rtc.exe yoki ./go2rtc/go2rtc)
# Linux serverda o'z yo'lini ko'rsating:
# GO2RTC_BINARY=/opt/go2rtc/go2rtc
# GO2RTC_CONFIG=/opt/go2rtc/go2rtc.yaml

# Recognition worker uchun python (default: backend python).
# Agar ML kutubxonalar alohida venv'da bo'lsa:
# RECOGNITION_PYTHON=/path/to/venv_worker/bin/python
# RECOGNITION_API_URL=http://localhost:8000

# --- Tanish sozlamalari (ixtiyoriy) ---
FACE_MATCH_COSINE_MIN=0.35          # tanish chegarasi (0.30-0.45)
WORKER_EMBEDDING_REFRESH_SECONDS=300 # embeddinglarni qayta yuklash oralig'i
WORKER_DEVICE=cuda                   # enroll/worker GPU yoki cpu
