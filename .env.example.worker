# HumanRecognition Worker Configuration

# WorkPlus API
WORKPLUS_API_URL=http://localhost:8000
AI_CAMERA_AGENT_TOKEN=your-32-byte-token-here

# GPU/Performance
WORKER_DEVICE=cuda
WORKER_VRAM_LIMIT_GB=6
WORKER_FRAME_SKIP=2
WORKER_BATCH_SIZE=1

# Face Detection
YOLO_FACE_MODEL=yolov8n-face.pt
FACE_DETECTION_THRESHOLD=0.5
FACE_SIZE_MIN_PIXELS=50

# Face Embedding & Matching
EMBEDDING_DISTANCE_THRESHOLD=0.6
FACE_MATCH_CONFIDENCE_MIN=0.7

# Unknown Person Clustering
UNKNOWN_CLUSTER_DISTANCE=0.5
UNKNOWN_CLEANUP_DAYS=7

# Logging
WORKER_LOG_LEVEL=INFO
WORKER_LOG_FILE=human_recognition_worker.log

# Advanced
WORKER_STREAM_TIMEOUT_SECONDS=30
WORKER_API_RETRY_COUNT=3
WORKER_API_TIMEOUT_SECONDS=15
