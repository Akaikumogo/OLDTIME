AI_CAMERA_BACKEND_URL=http://127.0.0.1:8000
AI_CAMERA_AGENT_TOKEN=change-this-to-the-same-secret-as-backend

# Analysis cadence
AI_CAMERA_ANALYSIS_INTERVAL_SECONDS=3
AI_CAMERA_ANALYSIS_WORKERS=4
AI_CAMERA_ANALYSIS_PROFILE=main

# YOLO person detector
AI_CAMERA_YOLO_MODEL=yolov8n.pt
AI_CAMERA_YOLO_CONFIDENCE=0.35

# ReID matcher
AI_CAMERA_REID_GALLERY_DIR=reid_gallery
AI_CAMERA_REID_MODEL=osnet_x1_0
AI_CAMERA_REID_MODEL_PATH=
AI_CAMERA_REID_DEVICE=cuda
AI_CAMERA_REID_THRESHOLD=0.72
