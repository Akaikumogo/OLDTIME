DB_HOST=localhost
DB_PORT=5432
DB_NAME=workplus
DB_USER=postgres
DB_PASSWORD=replace-with-strong-db-password
DB_CONNECT_TIMEOUT=5
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

JWT_SECRET_KEY=replace-with-at-least-32-byte-random-secret
JWT_ALGORITHM=HS256

RESET_PASSWORD_ACCESS_KEY=replace-with-strong-reset-key
COMPUTER_AGENT_TOKEN=replace-with-at-least-32-byte-random-agent-token

# Bootstrap admin (faqat birinchi ishga tushganda DB bo'sh bo'lsa yaratiladi)
# Hammasini to'ldiring yoki butunlay olib tashlang.
BOOTSTRAP_ADMIN_FULL_NAME=Super Admin
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-strong-password

HIKVISION_POLLING_ENABLED=true
HIKVISION_USERNAME=admin
HIKVISION_PASSWORD=replace-with-hikvision-password
HIKVISION_SCHEME=http
HIKVISION_HTTP_PORT=80
HIKVISION_POLL_INTERVAL_SECONDS=5
HIKVISION_MAX_RESULTS=10
HIKVISION_PICTURES_DIR=face_captures
HIKVISION_RAW_LOG_FILE=raw_events.jsonl

WORKPLUS_TIMEZONE=Asia/Tashkent

# AI kamera media gateway (RTSP → HLS/WebRTC, masalan: MediaMTX yoki go2rtc)
# Misol: AI_CAMERA_MEDIA_GATEWAY_URL=http://localhost:8888
AI_CAMERA_MEDIA_GATEWAY_URL=

# Kamera agent token (AI detection botidan kelgan so'rovlar uchun)
CAMERA_AGENT_TOKEN=replace-with-at-least-32-byte-random-token

# Inference window (bir xodim bir vaqtda bir kamerada ko'rinishi uchun oyna, soniya)
AI_CAMERA_MULTI_MATCH_WINDOW_SECONDS=5
